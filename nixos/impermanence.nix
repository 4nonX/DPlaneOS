# DPlaneOS - Impermanence Layer (Task 4.4)
# ─────────────────────────────────────────────────────────────────────────────
# This module defines the persistent and ephemeral paths for the NAS.
#
# Mental model:
#   /           - ext4 system partition. Updates are NixOS generations on it
#                 (ota-module.nix); it is not wiped, but state that must
#                 survive a reinstall of the system partition belongs here:
#   /persist    - durable ext4. Never wiped. All state lives here.
#   /nix/store  - the system closures of the boot generations.
#
# What survives reboots (bound from /persist/* → live path):
#   - DPlaneOS databases (main + audit)
#   - Audit HMAC key
#   - GitOps state.yaml and repo checkout
#   - Machine SSH host keys (so clients don't see key-changed warnings)
#   - NixOS machine-id (for stable journald cursor)
#   - Rotated logs
#   - Samba state (passdb, tdb files)
#   - NetworkManager/networkd lease files (optional, stable IP helps)
#
# What does NOT survive (intentionally ephemeral):
#   - /tmp, /run, /var/run - always tmpfs anyway
#   - Package caches, build artifacts
#   - Anything not explicitly listed below
#
# Boundary rule:
#   NixOS owns /persist/nixos/ and /persist/ssh/
#   DPlaneOS daemon owns /persist/dplaneos/
#   No other service writes to /persist without an entry here.
# ─────────────────────────────────────────────────────────────────────────────

{ config, lib, pkgs, ... }:

{
  # ── impermanence module input (comes from flake.nix inputs) ────────────────
  # The module is imported here; it is declared as a flake input in flake.nix.
  imports = [];  # module itself added via flake, not here

  # ── Ensure /persist is mounted before activation ────────────────────────────
  # fileSystems entry is generated by disko.nix. We declare neededForBoot
  # here to guarantee it is available during early initrd.
  fileSystems."/persist".neededForBoot = true;

  # ── impermanence: bind-mount /persist/* into their live locations ─────────
  environment.persistence."/persist" = {

    hideMounts = true;   # hide bind-mounts from df/findmnt output for cleanliness

    # ── Top-level directories to bind from /persist ──────────────────────
    directories = [

      # ── DPlaneOS daemon state (the boundary: daemon owns this subtree) ─
      # All DB files, keys, gitops repo live under /persist/dplaneos/
      # The daemon's -db flag is set to /var/lib/dplaneos/dplaneos.db
      # which is bind-mounted from /persist/dplaneos/
      {
        directory = "/var/lib/dplaneos";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── Daemon logs ─────────────────────────────────────────────────────
      {
        directory = "/var/log/dplaneos";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── Daemon config (smb.conf, exports, dplaneos.conf) ────────────────
      # NixOS owns /etc but the daemon owns /etc/dplaneos/*.
      # We persist the daemon's subtree only.
      {
        directory = "/etc/dplaneos";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── Samba state (passdb.tdb, secrets.tdb, etc.) ─────────────────────
      # Without this, Samba user passwords are lost on reboot.
      {
        directory = "/var/lib/samba";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── Samba logs ───────────────────────────────────────────────────────
      {
        directory = "/var/log/samba";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── iSCSI (LIO) configuration ───────────────────────────────────────
      # `targetcli saveconfig` writes /etc/target/saveconfig.json; dplaned
      # replays it at startup (configfs is empty after every boot). On the
      # slot root it would be lost with the next OTA update.
      {
        directory = "/etc/target";
        user      = "root";
        group     = "root";
        mode      = "0700";
      }

      # ── NFS exports state ────────────────────────────────────────────────
      {
        directory = "/var/lib/nfs";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # ── Docker (container state, images, volumes) ────────────────────────
      # Docker's overlay2 graph is large and contains container state.
      # Without this, all containers are gone after reboot.
      {
        directory = "/var/lib/docker";
        user      = "root";
        group     = "root";
        mode      = "0710";
      }

      # ── NetworkManager leases (optional) ────────────────────────────────
      # Helps maintain stable DHCP addresses on networks that honour client-id.
      {
        directory = "/var/lib/NetworkManager";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

      # /etc/systemd/network is NOT persisted: the bind mount hid the files
      # NixOS links there (99-ethernet-default-dhcp.network), so a new install
      # never configured its network card. The root filesystem survives
      # reboots and updates, and the daemon's 05-dplane-* files with it; see
      # dplaneos-networkd-migrate below for files from the persisted copy.

      # ── systemd-networkd lease files ────────────────────────────────────
      {
        directory = "/var/lib/systemd/network";
        user      = "systemd-network";
        group     = "systemd-network";
        mode      = "0755";
      }

# ── Avahi host database ──────────────────────────────────────────────
      {
        directory = "/var/lib/avahi-daemon";
        user      = "avahi";
        group     = "avahi";
        mode      = "0755";
      }

      # ── System identity (UIDs/GIDs) ───────────────────────────────────
      # Fixes: environment.persistence: Neither /var/lib/nixos nor any of its
      # parents are persisted.
      {
        directory = "/var/lib/nixos";
        user      = "root";
        group     = "root";
        mode      = "0755";
      }

    ]; # directories

    # ── Individual files to bind from /persist ────────────────────────────
    files = [

      # dplane-state.json (the daemon's JSON-to-Nix state) lives in the
      # persisted /var/lib/dplaneos. Listing it here as well linked the file
      # to itself: the daemon could not read it ("too many levels of
      # symbolic links") and UI settings were never recorded for rebuilds.

      # ── Machine ID ───────────────────────────────────────────────────────
      # A stable machine-id ensures journald cursors survive reboots.
      # Without this, log rotation and journald forwarding break across reboots.
      "/etc/machine-id"

      # ── NixOS host SSH keys ───────────────────────────────────────────────
      # Persisting host keys means SSH clients don't see "host key changed"
      # warnings after a reinstall of the system partition.
      "/etc/ssh/ssh_host_rsa_key"
      "/etc/ssh/ssh_host_rsa_key.pub"
      "/etc/ssh/ssh_host_ed25519_key"
      "/etc/ssh/ssh_host_ed25519_key.pub"

      # /etc/hostid is not listed: it is installed from /persist/etc/hostid
      # on every activation (below).

    ]; # files

  }; # environment.persistence."/persist"

  # ── ZFS host ID: one per machine ───────────────────────────────────────────
  # ZFS tells systems apart by the host ID: multihost (MMP) needs a non-zero
  # one, and a pool still imported by one node is refused to another only
  # when their IDs differ. networking.hostId is one value for every system
  # built from this flake, so each machine creates its own once, keeps it on
  # /persist, and installs it as /etc/hostid on every activation (at boot,
  # before any pool is imported, and on every switch).
  environment.etc.hostid.enable = lib.mkForce false;
  system.activationScripts.dplaneosHostId = {
    deps = [ "etc" ];
    text = ''
      f=/persist/etc/hostid
      if [ ! -s "$f" ] || [ "$(${pkgs.coreutils}/bin/od -An -tx4 "$f" | ${pkgs.coreutils}/bin/tr -d ' ')" = 00000000 ]; then
        mkdir -p /persist/etc
        ${config.boot.zfs.package}/bin/zgenhostid -f -o "$f"
      fi
      rm -f /etc/hostid
      install -m 0644 "$f" /etc/hostid
    '';
  };

  # ── Create /persist subdirectories on first boot ───────────────────────────
  # systemd-tmpfiles creates these if they don't exist. Idempotent.
  systemd.tmpfiles.rules = [
    "d /persist/dplaneos          0755 root root -"
    "d /persist/dplaneos/gitops   0755 root root -"
    "d /persist/log               0755 root root -"
    "d /persist/ssh               0755 root root -"
    "d /persist/nixos             0755 root root -"
  ];

  # ── Network settings from the formerly persisted /etc/systemd/network ──────
  # Installs from before this change kept the daemon's 05-dplane-* files in
  # /persist/etc/systemd/network. Copy them back once, before networkd reads
  # its configuration; a file already in /etc/systemd/network is newer.
  systemd.services.dplaneos-networkd-migrate = {
    description = "DPlaneOS: restore network settings from /persist";
    wantedBy    = [ "systemd-networkd.service" ];
    before      = [ "systemd-networkd.service" ];
    after       = [ "local-fs.target" ];
    unitConfig.DefaultDependencies = false;
    unitConfig.ConditionDirectoryNotEmpty = "/persist/etc/systemd/network";
    serviceConfig = {
      Type            = "oneshot";
      RemainAfterExit = true;
      ExecStart       = pkgs.writeShellScript "dplaneos-networkd-migrate" ''
        mkdir -p /etc/systemd/network
        for f in /persist/etc/systemd/network/05-dplane-*; do
          [ -f "$f" ] || continue
          t=/etc/systemd/network/$(basename "$f")
          [ -e "$t" ] || cp -p "$f" "$t"
        done
      '';
    };
  };
}
